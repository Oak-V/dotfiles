<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.alacritty.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Alacritty.app/Contents/MacOS/alacritty</string>
        <string>--daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/alacritty-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/alacritty-daemon.err</string>

    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
